APP_NAME=Laravel
APP_ENV=local
APP_KEY=base64:jSmJFKlix7MbLAkJSBRO0BzLwND0G5cWmZb7XJXSqIk=
APP_DEBUG=true
APP_LOG_LEVEL=debug
APP_URL=http://localhost

# Standart ulanish — MySQL (egaz-indexator dagidek). Yozilgan har bir qator
# PostgreSQL nusxasiga ham ketadi: config/dual_write.php, docs/dual-write.md
DB_CONNECTION=mysql

# 'mysql' ulanishi — egaz_idxdb (loyihaning O'Z bazasi, ASOSIY yozish manzili).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=egaz_idxdb
DB_USERNAME=root
DB_PASSWORD=01200120

# EGAZ MAIN (brrgz) — 'mysql1' ulanishi: manba jadvallar (cms_users, organizations,
# tb_gas_debit, tb_requests ...) shu yerdan o'qiladi, tb_factory_signatures /
# tb_fc_invoices / tb_social_sphere shu bazaga yoziladi (egaz-indexator dagidek);
# nusxasi — pgsql1.
DB_HOST1=127.0.0.1
DB_DATABASE1=brrgz
DB_USERNAME1=root
DB_PASSWORD1=01200120

# --- Dual write (config/dual_write.php) -------------------------------------
# DUAL_WRITE=false qilinsa ilova FAQAT MySQL bilan ishlaydi — aynan egaz-indexator kabi.
# DUAL_WRITE=true  bo'lsa yagona farq: har bir yozuv PostgreSQL nusxasiga ham ketadi.
DUAL_WRITE=true
DUAL_WRITE_MIRROR=pgsql
DUAL_WRITE_MIRROR1=pgsql1
DUAL_WRITE_LOG=true
DUAL_WRITE_DRY_RUN=false
DUAL_WRITE_FAIL_OPEN=true

# Yuk xati QR tokeni (POST /factory-invoice javobidagi data.qr_token) — egaz-indexator
# dagidek. Kalit = EGAZ MAIN (egaz.uz) ilovasining XOM APP_KEY qiymati ("base64:..." bilan).
# Bo'sh bo'lsa yuk xati baribir yoziladi, token NULL qaytadi va logga error tushadi
# (config/waybill_qr.php).
# WAYBILL_QR_BASE_URL=https://egaz.uz/factory-invoice-qr
# WAYBILL_QR_KEY=

# egaz-push asosiy PostgreSQL — 'pgsql1' ulanishi (push tarafda 'pgsql' deb ataladi).
PGPUSH_HOST=127.0.0.1
PGPUSH_PORT=5432
PGPUSH_DATABASE=egaz_push
PGPUSH_USERNAME=postgres
PGPUSH_PASSWORD=postgres

# Indexator PostgreSQL — 'pgsql' ulanishi (push tarafda 'postgres_02').
# Prod'da alohida server: PGIDX_HOST=192.168.0.6, PGIDX_DATABASE=egaz_idxpost.
PGIDX_HOST=127.0.0.1
PGIDX_PORT=5432
PGIDX_DATABASE=egaz_push
PGIDX_USERNAME=postgres
PGIDX_PASSWORD=postgres
PGIDX_SCHEMA=public

BROADCAST_DRIVER=log
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_DRIVER=sync

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=log
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
