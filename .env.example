#--------------------------------------------------------------------------
# egaz-index13 (Laravel 13) — egaz-indexator ning ko'chirilgan nusxasi
#--------------------------------------------------------------------------
#
# MUHIM: o'zgaruvchi NOMLARI egaz-indexator dagidek qoldirilgan, ya'ni ishlab
# turgan serverdagi .env faylni SHU LOYIHAGA SHUNDAYLIGICHA ko'chirsa bo'ladi.
#
# Laravel 11+ ba'zi nomlarni o'zgartirgan; config fayllarda IKKALASI ham
# o'qiladi (yangi nom bo'lmasa eskisiga tushadi):
#     QUEUE_DRIVER      -> QUEUE_CONNECTION
#     CACHE_DRIVER      -> CACHE_STORE
#     BROADCAST_DRIVER  -> BROADCAST_CONNECTION
#     MAIL_DRIVER       -> MAIL_MAILER
#     FILESYSTEM_DRIVER -> FILESYSTEM_DISK
#     APP_LOG_LEVEL     -> LOG_LEVEL
#
# ⚠ PAROLLARNI BU YERDA BO'SH QOLDIRMANG va "X_PSW=" deb yozmang!
#   env() faqat getenv() === false bo'lgandagina koddagi default'ga tushadi;
#   bo'sh qiymat '' bo'lib o'tadi va default ISHLAMAYDI. Shuning uchun barcha
#   integratsiya login/parollari bu yerda IZOHDA turadi — real qiymatlarni
#   faqat .env faylida to'ldiring.

APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_LOG_LEVEL=debug
APP_URL=http://localhost

#--------------------------------------------------------------------------
# Bazalar
#--------------------------------------------------------------------------
# ILOVA IKKI BAZAGA YOZADI (dual write — config/dual_write.php):
#
#   ASOSIY (yozish + o'qish)        NUSXA (yozish)
#   mysql   = egaz_idxdb @ DB_HOST  →  pgsql   = PGIDX_*  (egaz_idxpost)
#   mysql1  = DB_DATABASE1 @ DB_HOST1 →  pgsql1  = PGPUSH_* (egaz_push)
#
# Ya'ni yozish egaz-indexator dagidek MySQL ga ketadi, keyin AYNAN shu qator
# `id` va `created_at` bilan PostgreSQL nusxasiga yoziladi.
#
# MANBA O'QISH: cms_users / organizations / tb_gas_debit `pgsql1` dan o'qiladi
# (egaz-push PostgreSQL — EGAZ MAIN o'rnini bosgan).
#
# Boshqa MySQL ulanishlari (`pg:sync` va eski kod uchun):
#   mysql_brrgz  = DB_DATABASE1 @ DB_HOST
#   mysql_egaz   = DB_DATABASE2 @ DB_HOST1

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=homestead
DB_USERNAME=homestead
DB_PASSWORD=secret

# EGAZ MAIN (brrgz) — 'mysql1' ulanishi. FactoryInvoice/FactorySignature shunga yozadi.
DB_HOST1=127.0.0.1
DB_DATABASE1=brrgz
DB_USERNAME1=homestead
DB_PASSWORD1=secret

# 'mysql_egaz' ulanishi (DB_HOST1 da). Kerak bo'lmasa berilmasa ham bo'ladi.
# DB_DATABASE2=egaz

# egaz-push asosiy PostgreSQL — 'pgsql1' ulanishi (egaz-push da nomi 'pgsql').
# `php artisan pg:sync` standart holda shunga yozadi.
PGPUSH_HOST=127.0.0.1
PGPUSH_PORT=5432
PGPUSH_DATABASE=egaz_push
PGPUSH_USERNAME=postgres
PGPUSH_PASSWORD=secret
# PGPUSH_SCHEMA=public
# PGPUSH_SSLMODE=prefer
# PGPUSH_TIMEOUT=30
# PGPUSH_STRINGIFY=false

# Indexator PostgreSQL — 'pgsql' ulanishi (egaz-push da nomi 'postgres_02').
# i_* / idx_* agregatlari, vw_* view'lar, tb_scales_logs, integration_logs ...
# Prod'da alohida server: PGIDX_HOST=192.168.0.6, PGIDX_DATABASE=egaz_idxpost.
# Lokalda ko'pincha egaz-push bilan bitta baza bo'ladi.
PGIDX_HOST=127.0.0.1
PGIDX_PORT=5432
PGIDX_DATABASE=egaz_idxpost
PGIDX_USERNAME=postgres
PGIDX_PASSWORD=secret
# PGIDX_SCHEMA=public
# PGIDX_SSLMODE=prefer
# PGIDX_TIMEOUT=30
# PGIDX_STRINGIFY=false

#--------------------------------------------------------------------------
# ClickHouse (smi2/phpclickhouse) — *2clickhouse va subscriber-stats komandalari
#--------------------------------------------------------------------------
# CLICKHOUSE_HOST=127.0.0.1
# CLICKHOUSE_PORT=8123
# CLICKHOUSE_DATABASE=default
# CLICKHOUSE_USERNAME=default
# CLICKHOUSE_PASSWORD=
# CLICKHOUSE_HTTPS=
# CLICKHOUSE_TIMEOUT_CONNECT=2
# CLICKHOUSE_TIMEOUT_QUERY=2
# CLICKHOUSE_RETRIES=0

#--------------------------------------------------------------------------
# Integratsiya HTTP Basic login/parollari (parollarni faqat .env da to'ldiring)
#--------------------------------------------------------------------------
# Zavod 1C -> POST /factory-signature
# FACTORYSIGNATURE_LOGIN=factory-signature
# FACTORYSIGNATURE_PSW=<kuchli parol>

# Zavod 1C -> POST /factory-invoice
# FACTORYINVOICE_LOGIN=factory-invoice
# FACTORYINVOICE_PSW=<kuchli parol>

# Tarozi -> POST /scales/info, /scales/photo
# SCALES_LOGIN=scales-weg
# SCALES_PSW=<kuchli parol>

# GNP kamera -> POST /gnp-camera
# CAMERA_LOGIN=gnp-cameras
# CAMERA_PSW=<kuchli parol>

# Gaz dispenserlari -> POST /dispensers
# DISPENSER_LOGIN=dispenser
# DISPENSER_PSW=<kuchli parol>

# Gravirovka -> POST /engraving
# ENGRAVING_LOGIN=engraving5
# ENGRAVING_PSW=<kuchli parol>

# Ijtimoiy soha -> POST /social-sphere
# SOCIALSPHERE_LOGIN=socsphere5
# SOCIALSPHERE_PSW=<kuchli parol>

# Sath o'lchagichlar -> POST /levelmeters
# LEVELMETERS_LOGIN=levelmeters
# LEVELMETERS_PSW=<kuchli parol>

# UzGPS -> POST /uzgps/{ver}
# UzGPS_LOGIN=uzgps-loc
# UzGPS_PSW=<kuchli parol>

# Servislardagi IP filtri (hozir izohda — koddagi tekshiruv o'chirilgan)
# ALLOW_IP=127.0.0.1

#--------------------------------------------------------------------------
# Navbat (queue) va DB triggerlar
#--------------------------------------------------------------------------
BROADCAST_DRIVER=log
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_DRIVER=sync

# Transaction / Realizations / OrgDebit job'larini butunlay o'chirish
# JOBS_DISABLE=false

# config/db_triggers.php — batafsil: docs/db-triggers-to-service-migration.md
# PHP triggerlari FAQAT nusxa (PostgreSQL) ulanishlarida ishlaydi —
# config/db_triggers.php → php_connections. MySQL da ishni baza o'zi qiladi.
# DB_TRIGGERS_PHP=true
# DB_TRIGGERS_CONNECTION=
# DB_TRIGGERS_LOG=true
# DB_TRIGGERS_DRY_RUN=false
# DB_TRIGGERS_FAIL_OPEN=false
# DB_TRIGGERS_MAX_OLD_ROWS=5000

# config/dual_write.php — ikki bazaga yozish. Batafsil: docs/dual-write.md
# DUAL_WRITE=true                 # false → faqat MySQL (indexator xatti-harakati)
# DUAL_WRITE_MIRROR=pgsql         # `mysql` ulanishining nusxasi
# DUAL_WRITE_MIRROR1=pgsql1       # `mysql1` ulanishining nusxasi
# DUAL_WRITE_LOG=true             # har bir nusxa amali logga (DUALW)
# DUAL_WRITE_DRY_RUN=false        # nusxa bazaga yozmaydi, faqat logga
# DUAL_WRITE_FAIL_OPEN=true       # nusxa xatosi asosiy amalni buzmaydi
# DUAL_WRITE_TRIGGERS=true        # nusxada PHP triggerlari ishlaydi
# DUAL_WRITE_COPY_ID=true         # MySQL bergan id nusxaga ko'chiriladi
# DUAL_WRITE_BULK_IDS=false       # bulk INSERT da id ko'chirilmaydi (kafolat yo'q)
# DUAL_WRITE_GENERATE_ID=true     # nusxada id NOT NULL bo'lsa MAX(id)+1
# DUAL_WRITE_MAX_FAILURES=20      # ketma-ket shuncha xatodan keyin to'xtatiladi

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
